{
  "Type": "Abstract",
  "Debug": "DisplayState",
  "StartState": "Idle",
  "Parameters": {
    "Appearance": {
      "Value": "Vorthrax",
      "Description": "Model to be used"
    },
    "DropList": {
      "Value": "Empty",
      "Description": "Drop Items"
    },
    "FlockArray": {
      "Value": [ "Template_Birds_Passive" ],
      "Description": "Array containing NPCs for this flock type"
    },
    "WanderRadius": {
      "Value": 100,
      "Description": "The radius used for wandering and leashing"
    },
    "MinHeightOverGround": {
      "Value": 30,
      "Description": "Min Height over ground"
    },
    "MaxHeightOverGround": {
      "Value": 80,
      "Description": "Max Height over ground"
    },
    "RetreatMinHeight": {
      "Value": 60,
      "Description": "Min height over ground during post-attack retreat"
    },
    "MaxHealth": {
      "Value": 500,
      "Description": "Max health for the NPC"
    },
    "IsMemory": {
      "Value": false,
      "Description": "Defines if the NPC is a memory"
    },
    "MemoriesCategory": {
      "Value": "Other",
      "Description": "Defines the category of the memory"
    },
    "MemoriesNameOverride": {
      "Value": "",
      "Description": "Overrides the memory name if set"
    },
    "NameTranslationKey": {
      "Value": "server.npcRoles.Template.name",
      "Description": "Translation key for NPC name display"
    },
    "AggroRange": {
      "Value": 80,
      "Description": "Range at which the NPC spots and attacks the player"
    },
    "Attack": {
      "Value": "Root_NPC_Vorthrax_Attack",
      "Description": "Attack Root Interaction asset"
    },
    "RangedAttack": {
      "Value": "Root_NPC_Vorthrax_Spit",
      "Description": "Ranged attack Root Interaction asset"
    },
    "RangedAttackDistance": {
      "Value": 60,
      "Description": "Distance at which the NPC uses ranged attack"
    },
    "BiteDamageAmount": {
      "Value": 25,
      "Description": "Physical damage dealt by bite"
    },
    "BiteKnockback": {
      "Value": 0.4,
      "Description": "Knockback force applied on bite"
    }
  },
  "IsMemory": { "Compute": "IsMemory" },
  "MemoriesCategory": { "Compute": "MemoriesCategory" },
  "MemoriesNameOverride": { "Compute": "MemoriesNameOverride" },
  "DropList": { "Compute": "DropList" },
  "FlockSpawnTypes": { "Compute": "FlockArray" },
  "DisableDamageGroups": [ "Self" ],
  "Appearance": { "Compute": "Appearance" },
  "KnockbackScale": 0.5,
  "MotionControllerList": [
    {
      "Type": "Fly",
      "MaxHorizontalSpeed": 50,
      "MaxSinkSpeed": 25,
      "MaxClimbSpeed": 25,
      "MinAirSpeed": 25,
      "Acceleration": 40,
      "MinHeightOverGround": { "Compute": "MinHeightOverGround" },
      "MaxHeightOverGround": { "Compute": "MaxHeightOverGround" },
      "MaxRollAngle": 180,
      "MaxTurnSpeed": 360
    }
  ],
  "MaxHealth": { "Compute": "MaxHealth" },
  "Instructions": [
    {
      "Continue": true,
      "Instructions": [
        {
          "$Comment": "Always open to receiving beacon messages",
          "Sensor": {
            "Type": "Beacon",
            "Message": "Flock_Pos"
          },
          "Actions": [
            {
              "Type": "SetLeashPosition",
              "ToTarget": true
            }
          ]
        }
      ]
    },
    {
      "Instructions": [
        {
          "Sensor": { "Type": "State", "State": "Idle" },
          "Instructions": [
            {
              "Sensor": { "Type": "State", "State": ".Default" },
              "Actions": [
                { "Type": "PlayAnimation", "Slot": "Status" },
                { "Type": "State", "State": ".Fly" }
              ]
            },
            {
              "Sensor": { "Type": "State", "State": ".Fly" },
              "Instructions": [
                {
                  "Sensor": { "Type": "Eval", "Expression": "blocked" },
                  "Actions": [
                    { "Type": "State", "State": ".Blocked" }
                  ]
                },
                {
                  "Continue": true,
                  "Sensor": { "Type": "Any" },
                  "Instructions": [
                    {
                      "Reference": "Component_Instruction_Spread_Out",
                      "Modify": { "Range": 1 }
                    },
                    {
                      "Sensor": {
                        "Type": "Leash",
                        "Range": { "Compute": "WanderRadius" }
                      },
                      "BodyMotion": {
                        "Type": "Seek",
                        "SlowDownDistance": 1.5,
                        "StopDistance": 1,
                        "RelativeSpeed": 0.25
                      }
                    },
                    {
                      "Sensor": { "Type": "Any" },
                      "BodyMotion": {
                        "Type": "WanderInCircle",
                        "Radius": { "Compute": "WanderRadius" },
                        "MaxHeadingChange": 60,
                        "RelativeSpeed": 0.25
                      }
                    }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "Or",
                        "Sensors": [
                          {
                            "Type": "Self",
                            "Filters": [ { "Type": "Flock", "FlockStatus": "NotMember" } ]
                          },
                          {
                            "Type": "And",
                            "Sensors": [
                              { "Type": "FlockLeader" },
                              {
                                "Type": "Self",
                                "Filters": [ { "Type": "Flock", "FlockStatus": "Leader" } ]
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "Type": "Leash",
                        "Range": { "Compute": "WanderRadius + 1" }
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "FlockBeacon",
                      "Message": "Flock_Pos",
                      "SendToSelf": false,
                      "ExpirationTime": 0.5
                    },
                    { "Type": "SetLeashPosition", "ToCurrent": true }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Damage",
                    "Combat": true,
                    "TargetSlot": "LockedTarget"
                  },
                  "Actions": [ { "Type": "State", "State": "Combat" } ]
                },
                {
                  "Sensor": {
                    "Type": "Damage",
                    "Combat": false,
                    "Other": true
                  },
                  "Actions": [ { "Type": "State", "State": "Panic" } ]
                },
                {
                  "$Comment": "Aggro: spot player in range with line of sight",
                  "Sensor": {
                    "Type": "Player",
                    "Range": { "Compute": "AggroRange" },
                    "LockOnTarget": true,
                    "Filters": [ { "Type": "LineOfSight" } ]
                  },
                  "Actions": [ { "Type": "State", "State": "Combat" } ]
                }
              ]
            },
            {
              "Sensor": {
                "$TODO": "Remove this state and its references when there's a better way to handle being blocked",
                "Type": "State",
                "State": ".Blocked"
              },
              "Instructions": [
                {
                  "Continue": true,
                  "Sensor": { "Type": "Any", "Once": true },
                  "Actions": [
                    { "Type": "PlayAnimation", "Slot": "Status", "Animation": "Walk" }
                  ]
                },
                {
                  "Sensor": {
                    "Type": "Not",
                    "Sensor": { "Type": "Eval", "Expression": "blocked" }
                  },
                  "Actions": [ { "Type": "State", "State": ".Default" } ]
                },
                {
                  "Sensor": { "Type": "Any" },
                  "BodyMotion": {
                    "Type": "Wander",
                    "MinHeadingChange": 150,
                    "MaxHeadingChange": 180,
                    "RelativeSpeed": 1
                  }
                }
              ]
            }
          ]
        },
        {
          "Sensor": { "Type": "State", "State": "Panic" },
          "Instructions": [
            {
              "Continue": true,
              "Sensor": { "Type": "Any", "Once": true },
              "Actions": [
                { "Type": "PlayAnimation", "Slot": "Status", "Animation": "FlyFast" }
              ]
            },
            {
              "Continue": true,
              "Sensor": { "Type": "Any" },
              "Instructions": [
                {
                  "Sensor": { "Type": "Eval", "Expression": "blocked" },
                  "BodyMotion": {
                    "Type": "Timer",
                    "Time": [ 4, 8 ],
                    "Motion": {
                      "Type": "Wander",
                      "MaxHeadingChange": 45,
                      "RelativeSpeed": 1
                    }
                  }
                },
                {
                  "Reference": "Component_Instruction_Spread_Out",
                  "Modify": { "Range": 1, "RelativeSpeed": 1 }
                },
                {
                  "Sensor": { "Type": "Any" },
                  "BodyMotion": {
                    "Type": "Sequence",
                    "Looped": true,
                    "Motions": [
                      {
                        "Type": "Timer",
                        "Time": [ 4, 8 ],
                        "Motion": {
                          "Type": "WanderInCircle",
                          "Radius": 10,
                          "MaxHeadingChange": 45,
                          "RelativeSpeed": 1
                        }
                      },
                      {
                        "Type": "Timer",
                        "Time": [ 3, 10 ],
                        "Motion": {
                          "Type": "WanderInCircle",
                          "Radius": 10,
                          "MaxHeadingChange": 90,
                          "RelativeSpeed": 1
                        }
                      }
                    ]
                  }
                }
              ]
            },
            {
              "Reference": "Component_Instruction_State_Timeout",
              "Modify": {
                "_ExportStates": [ "Idle" ],
                "Delay": [ 3, 6 ]
              }
            }
          ]
        },
        {
          "Sensor": { "Type": "State", "State": "Combat" },
          "Instructions": [
            {
              "$Comment": "Animations",
              "Continue": true,
              "Sensor": { "Type": "Any", "Once": true },
              "Actions": [
                { "Type": "PlayAnimation", "Slot": "Status", "Animation": "FlyFast" }
              ]
            },
            {
              "$Comment": "Player out of range — chase for 5 seconds, then give up and go Idle",
              "Continue": true,
              "Sensor": {
                "Type": "Not",
                "Sensor": {
                  "Type": "Player",
                  "Range": { "Compute": "AggroRange" }
                }
              },
              "Instructions": [
                {
                  "Reference": "Component_Instruction_State_Timeout",
                  "Modify": {
                    "_ExportStates": [ "Idle" ],
                    "Delay": [ 5, 5 ]
                  }
                },
                {
                  "$Comment": "Chase the last known target position while waiting",
                  "Sensor": {
                    "Type": "Target",
                    "TargetSlot": "LockedTarget"
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 30,
                    "StopDistance": 20,
                    "RelativeSpeed": 1
                  }
                },
                {
                  "$Comment": "No locked target — wander in place",
                  "Sensor": { "Type": "Any" },
                  "BodyMotion": {
                    "Type": "Wander",
                    "MaxHeadingChange": 30,
                    "RelativeSpeed": 0.5
                  }
                }
              ]
            },
            {
              "$Comment": "Pattern A — Melee dive (50%): charge in, strike at close range, then Strafe through",
              "Continue": true,
              "Sensor": {
                "Type": "Random",
                "TrueDurationRange": [ 3, 6 ],
                "FalseDurationRange": [ 0.1, 0.1 ]
              },
              "Instructions": [
                {
                  "$Comment": "In strike range — attack and enter Strafe",
                  "Sensor": {
                    "Type": "Player",
                    "Range": 25,
                    "LockOnTarget": true,
                    "Filters": [ { "Type": "LineOfSight" } ]
                  },
                  "Actions": [
                    {
                      "Type": "Attack",
                      "Attack": { "Compute": "Attack" },
                      "AttackType": "Primary"
                    },
                    { "Type": "State", "State": "Strafe" }
                  ]
                },
                {
                  "$Comment": "Not close yet — dive toward player",
                  "Sensor": {
                    "Type": "Player",
                    "Range": { "Compute": "AggroRange" },
                    "LockOnTarget": true
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 30,
                    "StopDistance": 20,
                    "RelativeSpeed": 1
                  }
                }
              ]
            },
            {
              "$Comment": "Pattern B — Fast charge (25%): same but faster",
              "Continue": true,
              "Sensor": {
                "Type": "Random",
                "TrueDurationRange": [ 3, 6 ],
                "FalseDurationRange": [ 0.1, 0.1 ]
              },
              "Instructions": [
                {
                  "$Comment": "In strike range — attack and enter Strafe",
                  "Sensor": {
                    "Type": "Player",
                    "Range": 25,
                    "LockOnTarget": true,
                    "Filters": [ { "Type": "LineOfSight" } ]
                  },
                  "Actions": [
                    {
                      "Type": "Attack",
                      "Attack": { "Compute": "Attack" },
                      "AttackType": "Primary"
                    },
                    { "Type": "State", "State": "Strafe" }
                  ]
                },
                {
                  "$Comment": "Not close yet — charge fast",
                  "Sensor": {
                    "Type": "Player",
                    "Range": { "Compute": "AggroRange" },
                    "LockOnTarget": true
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 30,
                    "StopDistance": 20,
                    "RelativeSpeed": 1.5
                  }
                }
              ]
            },
            {
              "$Comment": "Pattern C — Ranged fallback (25%): spit from mid range",
              "Continue": true,
              "Sensor": { "Type": "Any" },
              "Instructions": [
                {
                  "$Comment": "Mid range with line of sight — ranged attack",
                  "Sensor": {
                    "Type": "And",
                    "Sensors": [
                      {
                        "Type": "Player",
                        "Range": { "Compute": "RangedAttackDistance" },
                        "LockOnTarget": true,
                        "Filters": [ { "Type": "LineOfSight" } ]
                      },
                      {
                        "Type": "Not",
                        "Sensor": { "Type": "Player", "Range": 25 }
                      }
                    ]
                  },
                  "Actions": [
                    {
                      "Type": "Attack",
                      "Attack": { "Compute": "RangedAttack" },
                      "BallisticMode": "Short",
                      "AimingTimeRange": [ 1, 2 ],
                      "AttackPauseRange": [ 2, 4 ]
                    }
                  ],
                  "HeadMotion": {
                    "Type": "Aim",
                    "Spread": 0,
                    "HitProbability": 1,
                    "Deflection": true
                  }
                },
                {
                  "$Comment": "Too far — approach slowly",
                  "Sensor": {
                    "Type": "Player",
                    "Range": { "Compute": "AggroRange" },
                    "LockOnTarget": true
                  },
                  "BodyMotion": {
                    "Type": "Seek",
                    "SlowDownDistance": 30,
                    "StopDistance": 30,
                    "RelativeSpeed": 0.75
                  }
                }
              ]
            }
          ]
        },
        {
          "$Comment": "Strafe — keep flying straight in current direction for a short time, then Retreat",
          "Sensor": { "Type": "State", "State": "Strafe" },
          "Instructions": [
            {
              "$Comment": "Fly straight ahead — MaxHeadingChange 0 locks the heading completely",
              "Continue": true,
              "Sensor": { "Type": "Any" },
              "BodyMotion": {
                "Type": "Wander",
                "MinHeadingChange": 0,
                "MaxHeadingChange": 0,
                "RelativeSpeed": 1.5
              }
            },
            {
              "$Comment": "After flying through, go to Retreat to climb",
              "Reference": "Component_Instruction_State_Timeout",
              "Modify": {
                "_ExportStates": [ "Retreat" ],
                "Delay": [ 0.5, 1.0 ]
              }
            }
          ]
        },
        {
          "$Comment": "Retreat — climb high and reposition, then return to Combat",
          "Sensor": { "Type": "State", "State": "Retreat" },
          "Instructions": [
            {
              "$Comment": "Apply altitude override every tick while retreating",
              "Continue": true,
              "Sensor": { "Type": "Any" },
              "Actions": [
                {
                  "Type": "OverrideAltitude",
                  "DesiredAltitudeRange": [ 80, 100 ]
                }
              ]
            },
            {
              "$Comment": "Return to Combat after climbing",
              "Reference": "Component_Instruction_State_Timeout",
              "Modify": {
                "_ExportStates": [ "Combat" ],
                "Delay": [ 2, 4 ]
              }
            },
            {
              "$Comment": "Flee from player while climbing to gain distance",
              "Sensor": {
                "Type": "Player",
                "Range": { "Compute": "AggroRange" },
                "LockOnTarget": true
              },
              "BodyMotion": {
                "Type": "Flee",
                "SlowDownDistance": 20,
                "StopDistance": { "Compute": "AggroRange * 0.50" },
                "RelativeSpeed": 1
              }
            },
            {
              "$Comment": "Wander if player is out of range",
              "Sensor": { "Type": "Any" },
              "BodyMotion": {
                "Type": "WanderInCircle",
                "Radius": 40,
                "MaxHeadingChange": 1,
                "RelativeSpeed": 1
              }
            }
          ]
        }
      ]
    }
  ],
  "NameTranslationKey": { "Compute": "NameTranslationKey" }
}